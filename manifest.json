{
  "manifest_version": 3,
  "name": "Intercom Chat Auditor",
  "version": "1.0",
  "description": "Audits Intercom support chats, evaluating first-response SLAs, idle times, and SOP compliance using Google Gemini",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.intercom.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["scripts/background.js"],
    "service_worker": "scripts/background.js"
  }
}
